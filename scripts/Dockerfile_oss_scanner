# OSS Scanner build image for the Solidity compiler.


# Base image: same as the CI builds and tests with, i.e. the published build of
# scripts/docker/buildpack-deps/Dockerfile.ubuntu2404
# (tag: ghcr.io/argotorg/solidity-buildpack-deps:ubuntu2404-8).
# Bump it together with CI.
FROM ghcr.io/argotorg/solidity-buildpack-deps@sha256:2a8487a3f031000004dda3f16ac82115dd29f91b2dc91ff4f47cd6156ce5786c

ENV DEBIAN_FRONTEND=noninteractive \
    TERM=xterm \
    # Where soltest finds the EVMC VM for semantic tests (shipped in the base image).
    ETH_EVMONE=/usr/lib/libevmone.so

# Scanner contract: the checkout lives inside the image, at /src.
COPY . /src
WORKDIR /src

# Vendored dependencies are git submodules and the checkout may not include them.
# CMake would otherwise try to fetch them itself; do it explicitly here while the network is still up.
# deps/fuzztest is skipped: it is only used with -DPROPERTY_BASED_TESTS=ON, which this build does not enable.
RUN git config --global --add safe.directory '*' \
    && git submodule update --init --recursive \
        deps/fmtlib \
        deps/nlohmann-json \
        deps/range-v3 \
        test/ethdebugSchemaTests/ethdebug-format

# Build solc, the test drivers (soltest, isoltest, solfuzzer, yulrun, ...) the way CI does
# (scripts/ci/build.sh, PEDANTIC on), but with debug info and frame pointers.
RUN cmake -S /src -B /src/build -G Ninja \
      -DCMAKE_BUILD_TYPE=RelWithDebInfo \
      -DCMAKE_C_FLAGS="-g -fno-omit-frame-pointer" \
      -DCMAKE_CXX_FLAGS="-g -fno-omit-frame-pointer" \
    && cmake --build /src/build -j"$(nproc)"

# Cheap smoke tests so we know the image works; failures do not abort the build.
RUN cd /src/build \
    && ./solc/solc --version \
    && (./test/soltest -t 'syntaxTests/*' -t 'semanticTests/smoke/*' -- --no-smt \
        || echo "WARNING: soltest reported failures")

# Binaries left for the scanner:
#   /src/build/solc/solc                  compiler CLI (Solidity / Yul / Standard JSON input)
#   /src/build/test/soltest               Boost.Test unit + isoltest-driven tests
#   /src/build/test/tools/isoltest        file-based test runner
#   /src/build/test/tools/solfuzzer       AFL-style fuzz driver
#   /src/build/test/tools/yulrun          Yul interpreter
